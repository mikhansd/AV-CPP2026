<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_core</name>
  <version>0.0.0</version>
  <description>Core vehicle nodes: StateManager, DriveArbiter, TCP server, I2C bridge.</description>
  <maintainer email="carsonpquesada@gmail.com">avcpp</maintainer>
  <license>TODO: License declaration</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Message runtime for generated interfaces -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Core deps (build & exec) -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>
  <depend>cv_bridge</depend>
  <depend>robot_localization</depend>

  <!-- Launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- GStreamer: build-time (headers/pc files) -->
  <build_depend>pkg-config</build_depend>
  <build_depend>libgstreamer1.0-dev</build_depend>
  <build_depend>libgstreamer-plugins-base1.0-dev</build_depend>
  <build_depend>libgstrtspserver-1.0-dev</build_depend>

  <!-- GStreamer: runtime (shared libs) -->
  <exec_depend>libgstreamer1.0-0</exec_depend>
  <exec_depend>libgstreamer-plugins-base1.0-0</exec_depend>
  <exec_depend>libgstrtspserver-1.0-0</exec_depend>

  <!-- Tests -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
